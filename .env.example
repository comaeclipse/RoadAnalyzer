DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"
# Migrations only. Neon's pooler runs PgBouncer in transaction mode, which cannot
# hold the session-level advisory locks Prisma Migrate takes out.
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/database?sslmode=require"
MAPBOX_ACCESS_TOKEN="pk.server-token-with-navigation-scope"
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN="pk.public-url-restricted-token"
